---
const assetPath = (value: string) => `${import.meta.env.BASE_URL}${value.replace(/^\//, "")}`;
---

<div class="benchmarkr-quality-artwork" aria-hidden="true">
  <div class="benchmarkr-quality-artwork__ipad">
    <div class="benchmarkr-quality-artwork__screen">
      <img
        src={assetPath("/images/benchmarkr-quality/hero-inspection-screen.png")}
        alt=""
        loading="lazy"
      />
    </div>
    <img
      class="benchmarkr-quality-artwork__frame"
      src={assetPath("/images/benchmarkr-quality/ipad-mini-frame.png")}
      alt=""
      loading="lazy"
    />
  </div>
</div>

<style>
  .benchmarkr-quality-artwork {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 22% 20%, rgb(255 255 255 / 75%) 0 5%, transparent 5.5%),
      linear-gradient(145deg, #eee9fb 0%, #dcd2f4 100%);
  }

  .benchmarkr-quality-artwork__ipad {
    position: absolute;
    top: -22%;
    left: 50%;
    width: min(112%, 560px);
    aspect-ratio: 1;
    filter: drop-shadow(0 24px 28px rgb(32 22 61 / 28%));
    transform: translateX(-50%) rotate(2deg);
  }

  .benchmarkr-quality-artwork__screen {
    position: absolute;
    z-index: 1;
    top: 6.55%;
    left: 21.13%;
    overflow: hidden;
    width: 57.74%;
    height: 86.92%;
    border-radius: 3.4% / 2.2%;
    background: #fff;
  }

  .benchmarkr-quality-artwork__screen img,
  .benchmarkr-quality-artwork__frame {
    display: block;
    width: 100%;
    height: 100%;
  }

  .benchmarkr-quality-artwork__screen img {
    object-fit: fill;
    object-position: top center;
  }

  .benchmarkr-quality-artwork__frame {
    position: absolute;
    z-index: 2;
    inset: 0;
    max-width: none;
    object-fit: fill;
    pointer-events: none;
  }

  @media (max-width: 620px) {
    .benchmarkr-quality-artwork__ipad {
      top: -12%;
      width: min(128%, 520px);
    }
  }
</style>
