---
import BenchmarkrWireframe from "../case-study/BenchmarkrWireframe.astro";
---

<div class="benchmarkr-card-artwork" aria-hidden="true">
  <div class="benchmarkr-card-artwork__note">
    <span>ONGOING PILOT</span>
    <strong>One product. One live quality process.</strong>
  </div>
  <BenchmarkrWireframe scene="inspection-checkpoint" compact />
</div>

<style>
  .benchmarkr-card-artwork {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(125deg, rgb(37 36 35 / 0%) 45%, rgb(37 36 35 / 12%) 100%),
      repeating-linear-gradient(0deg, transparent 0 31px, rgb(37 36 35 / 7%) 31px 32px),
      #d9ebff;
  }

  .benchmarkr-card-artwork::before,
  .benchmarkr-card-artwork::after {
    position: absolute;
    border: 2px solid rgb(37 36 35 / 38%);
    content: "";
    transform: rotate(-7deg);
  }

  .benchmarkr-card-artwork::before {
    top: 8%;
    right: 5%;
    width: 18%;
    height: 24%;
    border-radius: 45% 50% 15% 18%;
  }

  .benchmarkr-card-artwork::after {
    right: 13%;
    bottom: 8%;
    width: 10%;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .benchmarkr-card-artwork :global(.benchmarkr-wireframe) {
    position: absolute;
    top: 10%;
    left: 26%;
    width: min(76%, 720px);
    height: 72%;
  }

  .benchmarkr-card-artwork__note {
    position: absolute;
    z-index: 2;
    top: 10%;
    left: 5%;
    display: grid;
    width: min(25%, 220px);
    gap: 8px;
    padding: 14px;
    border: 2px solid #252423;
    background: #fff8ef;
    box-shadow: 7px 8px 0 rgb(37 36 35 / 18%);
    color: #252423;
    transform: rotate(-2deg);
  }

  .benchmarkr-card-artwork__note span {
    color: #276da8;
    font-family: var(--type-font-body);
    font-size: clamp(0.62rem, 1.1vw, 0.78rem);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .benchmarkr-card-artwork__note strong {
    font-family: var(--type-font-display);
    font-size: clamp(0.95rem, 2vw, 1.35rem);
    line-height: 1.1;
  }

  @media (max-width: 620px) {
    .benchmarkr-card-artwork :global(.benchmarkr-wireframe) {
      top: 12%;
      left: 12%;
      width: 94%;
      height: 68%;
    }

    .benchmarkr-card-artwork__note {
      top: 6%;
      left: 4%;
      width: min(38%, 170px);
      padding: 10px;
    }
  }
</style>
