---
const assetPath = (value: string) => `${import.meta.env.BASE_URL}${value.replace(/^\//, "")}`;
---

<div class="meetly-navigation-artwork" aria-hidden="true">
  <div class="meetly-navigation-artwork__laptop">
    <div class="meetly-navigation-artwork__display">
      <span class="meetly-navigation-artwork__camera"></span>
      <div class="meetly-navigation-artwork__screen">
        <img
          src={assetPath("/images/MeeetlyFinal2023.png")}
          alt=""
          loading="lazy"
        />
      </div>
    </div>
    <div class="meetly-navigation-artwork__base">
      <span></span>
    </div>
  </div>
</div>

<style>
  .meetly-navigation-artwork {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 18%, rgb(255 255 255 / 78%) 0 5%, transparent 5.5%),
      linear-gradient(145deg, #e4f4ff 0%, #bddff5 100%);
  }

  .meetly-navigation-artwork__laptop {
    position: absolute;
    top: -6%;
    left: 50%;
    width: min(88%, 760px);
    filter: drop-shadow(0 26px 28px rgb(18 48 69 / 30%));
    transform: translateX(-50%) rotate(-1.5deg);
  }

  .meetly-navigation-artwork__display {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    width: 91%;
    aspect-ratio: 1.6;
    margin: 0 auto;
    padding: 2.8% 2.3% 2.2%;
    border: 1px solid #54565a;
    border-radius: 18px 18px 7px 7px;
    background: linear-gradient(140deg, #292b2e 0%, #111214 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 8%),
      0 2px 0 #050506;
  }

  .meetly-navigation-artwork__camera {
    position: absolute;
    top: 1.25%;
    left: 50%;
    width: 4px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #05080c;
    box-shadow: 0 0 0 1px rgb(101 121 137 / 28%);
    transform: translateX(-50%);
  }

  .meetly-navigation-artwork__screen {
    overflow: hidden;
    width: 100%;
    height: 100%;
    border-radius: 3px;
    background: #fff;
  }

  .meetly-navigation-artwork__screen img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: top center;
  }

  .meetly-navigation-artwork__base {
    position: relative;
    z-index: 1;
    width: 100%;
    height: clamp(30px, 5vw, 44px);
    margin: -1px auto 0;
    border-radius: 3px 3px 18px 18px / 3px 3px 8px 8px;
    background:
      linear-gradient(90deg, transparent 0 49.3%, rgb(147 151 157 / 45%) 49.3% 50.7%, transparent 50.7%),
      linear-gradient(180deg, #f4f5f6 0%, #c6c9cc 54%, #9b9fa3 56%, #e1e3e5 74%, #aeb1b5 100%);
    clip-path: polygon(4.5% 0, 95.5% 0, 100% 68%, 98% 100%, 2% 100%, 0 68%);
  }

  .meetly-navigation-artwork__base span {
    position: absolute;
    top: 0;
    left: 50%;
    width: 13%;
    height: 24%;
    border-radius: 0 0 8px 8px;
    background: linear-gradient(180deg, #8f9397, #dfe1e3);
    transform: translateX(-50%);
  }

  @media (max-width: 620px) {
    .meetly-navigation-artwork__laptop {
      top: 3%;
      width: min(106%, 620px);
    }

    .meetly-navigation-artwork__display {
      border-radius: 14px 14px 6px 6px;
    }
  }
</style>
