---
import type { WireframeScene } from "../../data/benchmarkr";

interface Props {
  scene: WireframeScene;
  compact?: boolean;
}

const { scene, compact = false } = Astro.props;
---

<div
  class:list={["benchmarkr-wireframe", compact && "benchmarkr-wireframe--compact"]}
  data-scene={scene}
  aria-hidden="true"
>
  {
    scene === "inspection-checkpoint" && (
      <div class="wf-device wf-device--tablet">
        <div class="wf-device__camera" />
        <div class="wf-device__screen">
          <div class="wf-appbar">
            <span class="wf-brand">Benchmarkr</span>
            <span class="wf-language">EN · ES</span>
          </div>
          <div class="wf-inspection">
            <aside class="wf-product-rail">
              <span class="wf-kicker">Fire table</span>
              <strong>FT-042</strong>
              <span class="wf-serial">Serial 24-0318</span>
              <div class="wf-progress-ring"><span>3/6</span></div>
              <div class="wf-step-rail">
                <i class="is-complete" />
                <i class="is-complete" />
                <i class="is-current" />
                <i />
                <i />
                <i />
              </div>
            </aside>
            <div class="wf-task-panel">
              <div class="wf-task-heading">
                <span>Step 3 of 6</span>
                <strong>Inspect surface finish</strong>
              </div>
              <div class="wf-evidence-pair">
                <div class="wf-photo-card wf-photo-card--expected">
                  <span>Expected</span>
                  <div class="wf-photo-texture wf-photo-texture--smooth" />
                  <small>Approved finish</small>
                </div>
                <div class="wf-photo-card wf-photo-card--capture">
                  <span>Inspection</span>
                  <div class="wf-photo-texture wf-photo-texture--captured" />
                  <small>Captured now</small>
                </div>
              </div>
              <div class="wf-task-footer">
                <span class="wf-action wf-action--quiet">Report an issue</span>
                <span class="wf-action wf-action--primary">Continue</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    scene === "paper-vs-practice" && (
      <div class="wf-paper-practice">
        <div class="wf-paper-sheet">
          <div class="wf-paper-clip" />
          <span class="wf-stamp">OFFICIAL CHECKLIST</span>
          <strong>Fire table QC</strong>
          <ol>
            <li><i /> Pour concrete</li>
            <li><i /> Cure</li>
            <li><i /> Sand surface</li>
            <li><i /> Inspect finish</li>
            <li><i /> Pack</li>
          </ol>
          <span class="wf-paper-note">One straight line</span>
        </div>
        <div class="wf-practice-map">
          <span class="wf-stamp wf-stamp--blue">PRACTICED WORKFLOW</span>
          <div class="wf-map-row">
            <span class="wf-map-node">Pour</span>
            <i class="wf-map-arrow" />
            <span class="wf-map-node">Cure</span>
            <i class="wf-map-arrow" />
            <span class="wf-map-node">Check</span>
          </div>
          <div class="wf-map-detour">
            <span>Humidity changes timing</span>
            <i />
          </div>
          <div class="wf-map-row wf-map-row--offset">
            <span class="wf-map-node wf-map-node--overlap">Sand + inspect</span>
            <i class="wf-map-arrow" />
            <span class="wf-map-node">Rework?</span>
          </div>
          <div class="wf-map-loop">
            <i />
            <span>Manager workaround</span>
          </div>
          <div class="wf-practice-legend">
            <span><i class="wf-dot wf-dot--orange" /> exception</span>
            <span><i class="wf-dot wf-dot--blue" /> overlapping roles</span>
          </div>
        </div>
      </div>
    )
  }

  {
    scene === "separate-processes" && (
      <div class="wf-separated-model">
        <div class="wf-builder-card wf-builder-card--manufacturing">
          <div class="wf-window-bar"><i /><i /><i /></div>
          <span class="wf-stamp">PROCESS TYPE 01</span>
          <strong>Manufacturing</strong>
          <div class="wf-builder-field"><span>Instructions</span><i /></div>
          <div class="wf-builder-field"><span>Documents</span><i /></div>
          <div class="wf-builder-list"><i /><i /><i /></div>
          <span class="wf-locked-capability">Making capabilities only</span>
        </div>
        <div class="wf-hard-divider">
          <span>Hard rule</span>
          <i />
        </div>
        <div class="wf-builder-card wf-builder-card--quality">
          <div class="wf-window-bar"><i /><i /><i /></div>
          <span class="wf-stamp wf-stamp--blue">PROCESS TYPE 02</span>
          <strong>Quality Control</strong>
          <div class="wf-builder-field"><span>Reference photos</span><i /></div>
          <div class="wf-builder-field"><span>Evidence required</span><i /></div>
          <div class="wf-builder-list"><i /><i /><i /></div>
          <span class="wf-locked-capability">Inspection capabilities only</span>
        </div>
      </div>
    )
  }

  {
    scene === "step-builder" && (
      <div class="wf-unified-builder">
        <div class="wf-window-bar wf-window-bar--dark">
          <i /><i /><i /><span>Process template · Fire table quality</span>
        </div>
        <div class="wf-builder-layout">
          <aside class="wf-builder-steps">
            <span class="wf-kicker">Steps</span>
            <div><i class="is-done" /> Receive unit</div>
            <div><i class="is-done" /> Dimensions</div>
            <div class="is-selected"><i /> Surface finish</div>
            <div><i /> Burner fit</div>
            <div><i /> Final review</div>
            <span class="wf-add-row">+ Add Step</span>
          </aside>
          <div class="wf-builder-config">
            <div class="wf-config-heading">
              <div><span>Selected Step</span><strong>Surface finish</strong></div>
              <span class="wf-capability-badge">Configure where work varies</span>
            </div>
            <div class="wf-config-grid">
              <div class="wf-config-card">
                <span>Step guidance</span>
                <div class="wf-file-row"><i /> Finish-standard.pdf</div>
                <div class="wf-file-row"><i /> Lighting setup</div>
              </div>
              <div class="wf-config-card wf-config-card--task">
                <span>Task</span>
                <strong>Compare finish and gloss</strong>
                <div class="wf-toggle-row"><i class="is-on" /> Require inspection photo</div>
                <div class="wf-reference-row">
                  <i class="wf-mini-photo" /> Expected
                  <i class="wf-mini-photo wf-mini-photo--defect" /> Defect
                </div>
              </div>
              <div class="wf-config-card wf-config-card--small">
                <span>Task</span><strong>Record inspector signature</strong>
              </div>
              <span class="wf-add-task">+ Add Task</span>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    scene === "process-instance" && (
      <div class="wf-instance-journey">
        <div class="wf-view wf-view--overview">
          <div class="wf-view-top"><span>Overview</span><i>1</i></div>
          <span class="wf-kicker">Fire table · FT-042</span>
          <strong>Serial 24-0318</strong>
          <div class="wf-product-drawing"><i /><i /></div>
          <div class="wf-progress-bar"><i /></div>
          <small>3 of 6 Steps complete</small>
        </div>
        <i class="wf-journey-arrow" />
        <div class="wf-view wf-view--current">
          <div class="wf-view-top"><span>Current Step</span><i>2</i></div>
          <span class="wf-kicker">Same product</span>
          <strong>Surface finish</strong>
          <div class="wf-current-task"><i /> Compare gloss</div>
          <div class="wf-current-task"><i /> Capture evidence</div>
          <span class="wf-action wf-action--primary">Complete Step</span>
        </div>
        <i class="wf-journey-arrow" />
        <div class="wf-view wf-view--history">
          <div class="wf-view-top"><span>History</span><i>3</i></div>
          <span class="wf-kicker">Same product</span>
          <strong>Progress + evidence</strong>
          <div class="wf-history-line"><i class="is-done" /><span>Received</span></div>
          <div class="wf-history-line"><i class="is-done" /><span>Dimensions</span></div>
          <div class="wf-history-line"><i class="is-current" /><span>Surface finish</span></div>
          <div class="wf-history-line"><i /><span>Burner fit</span></div>
        </div>
      </div>
    )
  }

  {
    scene === "visual-verification" && (
      <div class="wf-verification">
        <div class="wf-verification-card wf-verification-card--expected">
          <div class="wf-verification-label"><i /> Expected</div>
          <div class="wf-large-photo wf-large-photo--expected"><i /><i /></div>
          <strong>Approved finish</strong>
          <small>Warm gray · low gloss</small>
        </div>
        <div class="wf-verification-card wf-verification-card--defect">
          <div class="wf-verification-label"><i /> Defect</div>
          <div class="wf-large-photo wf-large-photo--defect"><i /><i /></div>
          <strong>Known pinholes</strong>
          <small>Compare, don’t assume</small>
        </div>
        <div class="wf-verification-card wf-verification-card--inspection">
          <div class="wf-verification-label"><i /> Inspection</div>
          <div class="wf-large-photo wf-large-photo--inspection"><i /><i /></div>
          <strong>Captured unit</strong>
          <small>Evidence from FT-042</small>
        </div>
        <div class="wf-human-decision">
          <span>Human judgment</span>
          <i />
          <div><span>Looks right</span><span>Report issue</span></div>
        </div>
      </div>
    )
  }

  {
    scene === "needs-review" && (
      <div class="wf-review-window">
        <div class="wf-review-list">
          <div class="wf-review-heading"><strong>Needs Review</strong><span>Open · 3</span></div>
          <div class="wf-filter-row"><span>Process: Fire table quality</span><i /></div>
          <div class="wf-review-columns"><span>Serial</span><span>Process</span><span>Issues</span></div>
          <div class="wf-review-row is-selected"><strong>24-0318</strong><span>Fire table QC</span><i>2</i></div>
          <div class="wf-review-row"><strong>24-0321</strong><span>Fire table QC</span><i>1</i></div>
          <div class="wf-review-row"><strong>24-0324</strong><span>Fire table QC</span><i>1</i></div>
        </div>
        <div class="wf-review-detail">
          <div class="wf-detail-top"><span>Fire table · 24-0318</span><i>Needs Review</i></div>
          <span class="wf-kicker">Step context</span>
          <strong>Surface finish · Compare gloss</strong>
          <div class="wf-detail-evidence">
            <div><i class="wf-mini-photo" /><span>Expected</span></div>
            <div><i class="wf-mini-photo wf-mini-photo--capture" /><span>Inspection</span></div>
          </div>
          <p>Inspector reported gloss above the approved reference.</p>
          <div class="wf-review-actions">
            <span class="wf-action">Clear review</span>
            <span class="wf-action wf-action--primary">Send back</span>
            <span class="wf-action wf-action--danger">Reject</span>
          </div>
        </div>
      </div>
    )
  }

  {
    scene === "next-steps" && (
      <div class="wf-next-concepts">
        <div class="wf-scanner-concept">
          <span class="wf-plan-label">PLANNED 01</span>
          <strong>Touch-free completion</strong>
          <div class="wf-workstation">
            <div class="wf-scanner"><i /><i /></div>
            <div class="wf-barcode"><i /><i /><i /><i /><i /><i /><i /></div>
            <div class="wf-glove"><i /><i /><i /><i /></div>
            <span class="wf-scan-line" />
          </div>
          <small>Scan at a fixed workstation—no touchscreen navigation</small>
        </div>
        <div class="wf-analytics-concept">
          <span class="wf-plan-label">PLANNED 02</span>
          <strong>Aggregate process learning</strong>
          <div class="wf-chart">
            <div><span>Surface finish</span><i style="--bar: 84%" /></div>
            <div><span>Dimensions</span><i style="--bar: 58%" /></div>
            <div><span>Burner fit</span><i style="--bar: 36%" /></div>
            <div><span>Packaging</span><i style="--bar: 20%" /></div>
          </div>
          <div class="wf-trend-line"><i /><i /><i /><i /><span>Issue trend by Step</span></div>
        </div>
      </div>
    )
  }
</div>

<style>
  .benchmarkr-wireframe {
    --wf-ink: #252423;
    --wf-muted: #696a70;
    --wf-paper: #fffdf8;
    --wf-cream: #f7f2ea;
    --wf-blue: #59a7fd;
    --wf-blue-soft: #d9ebff;
    --wf-orange: #e98a4b;
    --wf-red: #bd4d48;
    --wf-green: #4d866a;
    width: 100%;
    height: 100%;
    min-width: 0;
    color: var(--wf-ink);
    container-type: inline-size;
    font-family: var(--type-font-body);
    font-size: clamp(7px, 1.15cqw, 13px);
    line-height: 1.25;
  }

  .benchmarkr-wireframe *,
  .benchmarkr-wireframe *::before,
  .benchmarkr-wireframe *::after {
    box-sizing: border-box;
  }

  .benchmarkr-wireframe strong,
  .benchmarkr-wireframe span,
  .benchmarkr-wireframe small {
    min-width: 0;
  }

  .wf-device {
    position: relative;
    width: 90%;
    height: 92%;
    margin: auto;
    border: max(2px, 0.35em) solid var(--wf-ink);
    border-radius: 2.2em;
    background: var(--wf-ink);
    box-shadow: 1.2em 1.4em 0 rgb(37 36 35 / 14%);
  }

  .wf-device__camera {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 0.55em;
    width: 0.55em;
    aspect-ratio: 1;
    border: 1px solid #62615f;
    border-radius: 50%;
    background: #0c0c0c;
  }

  .wf-device__screen {
    position: absolute;
    inset: 0.75em;
    overflow: hidden;
    border-radius: 1.3em;
    background: var(--wf-paper);
  }

  .wf-appbar {
    display: flex;
    height: 11%;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5em;
    border-bottom: 1px solid #d8d1c7;
    background: #fff;
  }

  .wf-brand {
    font-family: var(--type-font-display);
    font-size: 1.15em;
    font-weight: 650;
  }

  .wf-language {
    border: 1px solid #cbc4ba;
    border-radius: 999px;
    padding: 0.35em 0.7em;
    color: var(--wf-muted);
    font-size: 0.75em;
    font-weight: 700;
  }

  .wf-inspection {
    display: grid;
    height: 89%;
    grid-template-columns: 28% minmax(0, 1fr);
  }

  .wf-product-rail {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    padding: 1.2em 0.8em;
    border-right: 1px solid #d8d1c7;
    background: #f2eee7;
    text-align: center;
  }

  .wf-kicker {
    color: var(--wf-muted);
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wf-product-rail strong {
    margin-top: 0.3em;
    font-family: var(--type-font-display);
    font-size: 1.4em;
  }

  .wf-serial {
    color: var(--wf-muted);
    font-size: 0.68em;
  }

  .wf-progress-ring {
    display: grid;
    width: 3.8em;
    margin-top: 1em;
    aspect-ratio: 1;
    place-items: center;
    border: 0.55em solid #d6d1ca;
    border-top-color: var(--wf-blue);
    border-right-color: var(--wf-blue);
    border-radius: 50%;
    background: var(--wf-paper);
    transform: rotate(25deg);
  }

  .wf-progress-ring span {
    font-size: 0.72em;
    font-weight: 700;
    transform: rotate(-25deg);
  }

  .wf-step-rail {
    display: flex;
    width: 82%;
    justify-content: space-between;
    margin-top: auto;
  }

  .wf-step-rail i {
    width: 0.65em;
    aspect-ratio: 1;
    border: 1px solid #9f9a92;
    border-radius: 50%;
    background: var(--wf-paper);
  }

  .wf-step-rail .is-complete { border-color: var(--wf-green); background: var(--wf-green); }
  .wf-step-rail .is-current { border: 0.2em solid var(--wf-blue); }

  .wf-task-panel {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 1.2em 1.4em 1em;
  }

  .wf-task-heading { display: grid; gap: 0.2em; }
  .wf-task-heading span { color: var(--wf-muted); font-size: 0.72em; }
  .wf-task-heading strong { font-family: var(--type-font-display); font-size: 1.35em; }

  .wf-evidence-pair {
    display: grid;
    min-height: 0;
    flex: 1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8em;
    margin-top: 0.8em;
  }

  .wf-photo-card {
    display: grid;
    min-width: 0;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.45em;
    padding: 0.65em;
    border: 1px solid #c9c2b8;
    border-radius: 0.7em;
    background: #fff;
  }

  .wf-photo-card > span { font-size: 0.68em; font-weight: 750; text-transform: uppercase; }
  .wf-photo-card small { color: var(--wf-muted); font-size: 0.66em; }
  .wf-photo-texture { position: relative; min-height: 0; overflow: hidden; border-radius: 0.35em; background: #d8d2c8; }
  .wf-photo-texture::before,
  .wf-photo-texture::after { position: absolute; border: 1px solid rgb(37 36 35 / 52%); content: ""; }
  .wf-photo-texture::before { inset: 20% 12%; border-radius: 45% 55% 15% 20%; transform: skew(-7deg); }
  .wf-photo-texture::after { right: 20%; bottom: 18%; width: 34%; height: 26%; border-radius: 50%; }
  .wf-photo-texture--smooth { background: linear-gradient(145deg, #c8c0b3 0 45%, #e7e1d8 45% 62%, #bbb1a2 62%); }
  .wf-photo-texture--captured { background: repeating-linear-gradient(165deg, #c8c0b4 0 0.8em, #ded8ce 0.8em 1.5em); }

  .wf-task-footer { display: flex; justify-content: flex-end; gap: 0.55em; margin-top: 0.8em; }
  .wf-action { display: inline-flex; min-height: 2.3em; align-items: center; justify-content: center; border: 1px solid #aaa39a; border-radius: 0.5em; padding: 0.45em 0.75em; background: #fff; font-size: 0.68em; font-style: normal; font-weight: 750; text-align: center; }
  .wf-action--quiet { color: var(--wf-red); }
  .wf-action--primary { border-color: var(--wf-ink); background: var(--wf-ink); color: #fff; }
  .wf-action--danger { border-color: var(--wf-red); color: var(--wf-red); }

  .wf-paper-practice,
  .wf-separated-model,
  .wf-unified-builder,
  .wf-instance-journey,
  .wf-verification,
  .wf-review-window,
  .wf-next-concepts { width: 100%; height: 100%; }

  .wf-paper-practice { display: grid; align-items: center; grid-template-columns: 0.72fr 1.28fr; gap: 4%; padding: 4%; }
  .wf-paper-sheet { position: relative; display: flex; height: 92%; min-width: 0; flex-direction: column; padding: 9% 9% 7%; border: 1px solid #bdb5aa; background: var(--wf-paper); box-shadow: 0.7em 0.8em 0 rgb(37 36 35 / 10%); transform: rotate(-1.5deg); }
  .wf-paper-clip { position: absolute; top: -0.5em; left: 41%; width: 2.8em; height: 1.1em; border: 0.17em solid #77716a; border-bottom: 0; border-radius: 0.8em 0.8em 0 0; }
  .wf-stamp { align-self: flex-start; border: 1px solid var(--wf-orange); padding: 0.25em 0.45em; color: #a95828; font-size: 0.62em; font-weight: 800; letter-spacing: 0.06em; transform: rotate(-2deg); }
  .wf-stamp--blue { border-color: var(--wf-blue); color: #276da8; transform: rotate(1deg); }
  .wf-paper-sheet > strong { margin-top: 0.6em; font-family: var(--type-font-display); font-size: 1.25em; }
  .wf-paper-sheet ol { display: grid; gap: 0.48em; margin: 0.8em 0 0; padding: 0; counter-reset: paper; list-style: none; }
  .wf-paper-sheet li { display: flex; align-items: center; gap: 0.55em; border-bottom: 1px solid #dfd8ce; padding-bottom: 0.35em; font-size: 0.72em; }
  .wf-paper-sheet li i { width: 1em; aspect-ratio: 1; border: 1px solid #938c82; }
  .wf-paper-note { margin-top: auto; color: var(--wf-muted); font-family: var(--type-font-display); font-size: 0.85em; font-style: italic; }
  .wf-practice-map { position: relative; height: 94%; min-width: 0; padding: 5%; border: 1px dashed #aaa197; border-radius: 1em; background: #fbf5e9; }
  .wf-map-row { display: flex; align-items: center; gap: 0.55em; margin-top: 11%; }
  .wf-map-row--offset { margin-top: 10%; margin-left: 12%; }
  .wf-map-node { display: inline-flex; min-height: 2.8em; flex: 0 1 auto; align-items: center; justify-content: center; border: 1px solid var(--wf-ink); border-radius: 0.45em; padding: 0.45em 0.7em; background: #fff; font-size: 0.72em; font-weight: 700; text-align: center; }
  .wf-map-node--overlap { border-color: #347bb8; box-shadow: 0.35em 0.35em 0 var(--wf-blue-soft); }
  .wf-map-arrow { position: relative; width: 1.5em; height: 1px; flex: 0 1 1.5em; background: var(--wf-ink); }
  .wf-map-arrow::after { position: absolute; top: -0.26em; right: 0; width: 0.5em; aspect-ratio: 1; border-top: 1px solid var(--wf-ink); border-right: 1px solid var(--wf-ink); content: ""; transform: rotate(45deg); }
  .wf-map-detour { position: absolute; top: 11%; right: 5%; max-width: 38%; border-bottom: 1px solid var(--wf-orange); color: #9c5529; font-size: 0.66em; font-weight: 650; transform: rotate(2deg); }
  .wf-map-detour i { position: absolute; top: 100%; left: 20%; width: 1px; height: 3.4em; background: var(--wf-orange); transform: rotate(18deg); transform-origin: top; }
  .wf-map-loop { position: absolute; right: 7%; bottom: 19%; color: #9c5529; font-size: 0.65em; font-weight: 650; }
  .wf-map-loop i { position: absolute; right: 15%; bottom: 1.4em; width: 5.5em; height: 3em; border: 1px solid var(--wf-orange); border-left-color: transparent; border-radius: 0 2em 2em 0; transform: rotate(-12deg); }
  .wf-practice-legend { position: absolute; bottom: 4%; left: 5%; display: flex; flex-wrap: wrap; gap: 0.8em; color: var(--wf-muted); font-size: 0.62em; }
  .wf-practice-legend span { display: inline-flex; align-items: center; gap: 0.3em; }
  .wf-dot { width: 0.65em; aspect-ratio: 1; border-radius: 50%; }
  .wf-dot--orange { background: var(--wf-orange); }
  .wf-dot--blue { background: var(--wf-blue); }

  .wf-separated-model { display: grid; align-items: stretch; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 2.5%; padding: 4%; }
