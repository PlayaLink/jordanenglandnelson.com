<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-process-demo]").forEach((demo) => {
    const animation = demo.querySelector<HTMLElement>("[data-process-demo-animation]");
    const toggle = demo.querySelector<HTMLElement>("[data-process-demo-toggle]");

    if (!animation || !toggle) return;

    let isPaused = false;

    const updateToggle = () => {
      toggle.setAttribute("aria-label", isPaused ? "Play animation" : "Pause animation");
      toggle.setAttribute("aria-pressed", String(isPaused));
      animation.classList.toggle("is-paused", isPaused);
    };

    const applyMotionPreference = () => {
      animation.classList.toggle("is-reduced-motion", reducedMotion.matches);
      isPaused = reducedMotion.matches;
      updateToggle();
    };

    toggle.addEventListener("click", () => {
      animation.classList.remove("is-reduced-motion");
      isPaused = !isPaused;
      updateToggle();
    });

    toggle.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      toggle.click();
    });

    reducedMotion.addEventListener("change", applyMotionPreference);
    applyMotionPreference();
  });
</script>
