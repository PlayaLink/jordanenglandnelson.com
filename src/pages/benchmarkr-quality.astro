---
import BaseLayout from "../layouts/BaseLayout.astro";
import CopyReviewToolbar from "../components/CopyReviewToolbar.astro";
import NextCaseStudyCard from "../components/case-study/NextCaseStudyCard.astro";
import PhotoLightbox from "../components/PhotoLightbox.astro";
import { caseStudies } from "../data/homepage";

const assetPath = (value: string) => `${import.meta.env.BASE_URL}${value.replace(/^\//, "")}`;
const homeHref = `${import.meta.env.BASE_URL}#case-studies-title`;
const showCopyReview = import.meta.env.DEV;
const nextStory = caseStudies[1];
const nextStoryThumbnail = nextStory.image ?? nextStory.artworkImage;

const facts = [
  { label: "Role", value: "Solo designer and builder" },
  { label: "Deliverables", value: "Full-stack web application" },
  { label: "Year", value: "2025–Present" },
  { label: "Process", value: "Spec-driven, AI-assisted software development" },
  { label: "Duration", value: "7 months" },
  {
    label: "Collaborators",
    value: "Factory owner, floor manager, fabricators, and product inspectors",
  },
] as const;

const solutionShots = [
  {
    src: "/images/benchmarkr-quality/inspection-checklist.png",
    alt: "A Benchmarkr quality checklist with pass and fail reference images",
    dots: [{ x: 73.5, y: 52, step: 1 }],
  },
  {
    src: "/images/benchmarkr-quality/issue-reference.png",
    alt: "An inspection screen asking a worker to compare a product with a known issue",
    dots: [{ x: 19.8, y: 91.7, step: 2 }],
  },
  {
    src: "/images/benchmarkr-quality/camera-launch.png",
    alt: "The Benchmarkr inspection camera loading screen",
    dots: [{ x: 54.7, y: 91.7, step: 3 }],
  },
  {
    src: "/images/benchmarkr-quality/photo-comparison.png",
    alt: "A side-by-side comparison between a reference photo and an inspector's photo",
    dots: [{ x: 70.5, y: 94.5, step: 4 }],
  },
  {
    src: "/images/benchmarkr-quality/inspection-details.png",
    alt: "An inspection report with a reason, description, and supporting photos",
    dots: [
      { x: 55.2, y: 62.5, step: 5 },
      { x: 85.8, y: 94.9, step: 6 },
    ],
  },
  {
    src: "/images/benchmarkr-quality/completed-inspection.png",
    alt: "A completed checklist item pairing a fail reference with inspection evidence",
    dots: [{ x: 78.3, y: 53.3, step: 7 }],
  },
] as const;
---

<BaseLayout
  title="Reducing manufacturing flaws with Benchmarkr | Jordan England Nelson"
  description="How Jordan England Nelson designed and built a quality-assurance web application for a concrete furniture manufacturer."
  constrain={false}
  showBackLink={false}
  mainClass="quality-case-main"
>
  <nav class="quality-return" aria-label="Portfolio stories">
    <a class="quality-return__back" href={homeHref} aria-label="Back to stories">
      <span aria-hidden="true">←</span>
      <span class="quality-return__name">Jordan England-Nelson</span>
    </a>
  </nav>

  <article class="quality-case">
    <header class="quality-hero">
      <div class="quality-hero__copy">
        <h1>
          Reducing manufacturing <span>flaws</span> at a concrete furniture factory
        </h1>
        <p class="quality-hero__lede">
          How a quality assurance web application increases accountability and spec-adherence for
          Restoration Hardware's main supplier of concrete furniture.
        </p>

        <dl class="quality-facts">
          {facts.map((fact) => (
            <div class:list={["quality-fact", fact.label === "Collaborators" && "quality-fact--tall"]}>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="quality-hero__visual" aria-hidden="true">
        <div class="quality-hero-ipad">
          <div class="quality-hero-ipad__screen">
            <img
              src={assetPath("/images/benchmarkr-quality/hero-inspection-screen.png")}
              alt=""
              loading="eager"
            />
          </div>
          <img
            class="quality-hero-ipad__frame"
            src={assetPath("/images/benchmarkr-quality/ipad-mini-frame.png")}
            alt=""
            loading="eager"
          />
        </div>
      </div>
    </header>

    <section class="quality-section quality-section--problem" aria-labelledby="human-problem-title">
      <div class="quality-section__heading">
        <p class="quality-eyebrow">The human problem</p>
        <h2 id="human-problem-title">No accountability or visibility into process breakdown</h2>
      </div>

      <div class="human-problem-grid">
        <div class="quality-prose">
          <p>
            It is very difficult to determine exactly which step of the process led to a flaw that
            might only be discovered at the very end of the line.
          </p>
          <p>
            Paper checklists may get filled out, but it was often impossible to identify when and
            where a product flaw occurred without a photographic paper trail.
          </p>

          <blockquote>
            <p>“I have no sense of how closely they are following these steps.”</p>
            <footer>— CEO of furniture manufacturer</footer>
          </blockquote>

          <p>
            The physical prototype is hugely important in the approval process and referenced
            closely when setting up the manufacturing line, but rarely referenced after that.
          </p>
        </div>

        <figure class="human-problem-visual">
          <img
            src={assetPath("/images/benchmarkr-quality/paper-checklist-context.png")}
            alt="A paper quality checklist beside a concrete product on the factory floor"
            loading="lazy"
          />
          <figcaption class="human-problem-callout">
            <p>Paper checklists existed but had <strong>drawbacks:</strong></p>
            <ul>
              <li>Generic, one-size-fits-all</li>
              <li>No photo references to check during inspection</li>
              <li>No reporting</li>
            </ul>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="quality-section quality-section--technology" aria-labelledby="technology-problem-title">
      <div class="quality-section__heading">
        <p class="quality-eyebrow">The technology problem</p>
        <h2 id="technology-problem-title">Physical samples were too cumbersome to reference</h2>
      </div>

      <div class="technology-grid">
        <div class="quality-prose">
          <p>
            A singular physical prototype existed for each product line. These were stored far
            from the manufacturing line and were rarely referenced.
          </p>

          <p>
            The physical prototype is hugely important in the approval process and referenced
            closely when setting up the manufacturing line, but rarely referenced after that.
          </p>
          <p>
            Over time, variation creeps into the manufacturing process and the product can drift
            from the original specs.
          </p>
        </div>

        <img
          class="technology-visual"
          src={assetPath("/images/benchmarkr-quality/physical-sample.jpeg")}
          alt="A rectangular concrete finish sample photographed against a dark background"
          loading="lazy"
        />
      </div>
    </section>

    <section class="quality-section quality-section--solution" aria-labelledby="solution-title">
      <div class="quality-section__heading quality-section__heading--wide">
        <p class="quality-eyebrow">Solution</p>
        <h2 id="solution-title">
          Replace paper checklists with visual references and photo inspection capture
        </h2>
      </div>

      <figure class="solution-gallery">
        <div class="solution-gallery__grid" data-lightbox-gallery="solution-workflow">
          {solutionShots.map((shot) => (
            <div class="solution-shot">
              <img src={assetPath(shot.src)} alt={shot.alt} loading="lazy" />
              {shot.dots.map((dot) => (
                <span class="solution-dot" style={`--dot-x: ${dot.x}%; --dot-y: ${dot.y}%`} aria-hidden="true">
                  {dot.step}
                </span>
              ))}
            </div>
          ))}
        </div>
        <figcaption>
          Inspectors compare the product in front of them with pass and fail references, capture
          evidence, explain deviations, and leave a visible record for managers.
        </figcaption>
      </figure>
    </section>

    <section class="quality-section quality-section--processes" aria-labelledby="processes-title">
      <div class="quality-section__heading quality-section__heading--wide">
        <h2 id="processes-title">Define processes with pass and fail reference photos</h2>
      </div>

      <div class="process-intro quality-prose">
        <p>
          A central question was how to store the process steps that would define how to
          manufacture a given SKU.
        </p>
        <p>
          Defining the process on the SKU itself proved to be too limiting, because multiple SKUs
          might share the same process.
        </p>
      </div>

      <div class="process-figures">
        <figure class="process-figure--demo" data-process-demo>
          <div class="process-demo-stage">
            <div class="process-demo-layout">
              <div class="process-demo-ipad-column">
                <div
                  class="ipad-mini"
                  data-process-demo-toggle
                  role="button"
                  tabindex="0"
                  aria-label="Pause animation"
                  aria-pressed="false"
                >
                  <div class="ipad-mini__screen">
                    <div
                      class="process-demo-animation"
                      data-process-demo-animation
                      aria-label="Step four opens a side drawer and moves through its configuration settings"
                    >
                      <img
                        class="process-demo-animation__base"
                        src={assetPath("/images/benchmarkr-quality/process-template-animation.png")}
                        alt="The Fire Table QC Process template made of seven configurable steps"
                      />
                      <svg
                        class="process-demo-animation__labels"
                        viewBox="0 0 768 1072"
                        aria-hidden="true"
                      >
                        <rect x="260" y="24" width="220" height="38" fill="#fff" />
                        <rect x="264" y="28" width="184" height="31" rx="6" fill="#f7f7f9" />
                        <text
                          x="273"
                          y="50"
                          fill="#374151"
                          font-family="Inter, Arial, sans-serif"
                          font-size="15"
                          font-weight="600">Fire Table QC Process</text
                        >
                        <rect x="142" y="77" width="430" height="49" fill="#fff" />
                        <text
                          x="148"
                          y="115"
                          fill="#111827"
                          font-family="Inter, Arial, sans-serif"
                          font-size="38"
                          font-weight="700">Fire Table QC Process</text
                        >
                      </svg>
                      <div class="process-demo-animation__drawer" aria-hidden="true">
                        <img
                          class="process-demo-animation__drawer-image"
                          src={assetPath("/images/benchmarkr-quality/process-drawer-full.png")}
                          alt=""
                        />
                      </div>
                    </div>
                  </div>
                  <img
                    class="ipad-mini__frame"
                    src={assetPath("/images/benchmarkr-quality/ipad-mini-frame.png")}
                    alt=""
                    loading="lazy"
                    aria-hidden="true"
                  />
                </div>

              </div>

              <div class="process-demo-references">
                <img
                  class="process-template-reference"
                  src={assetPath("/images/benchmarkr-quality/process-template-reference.png")}
                  alt="The full Fire Table QC Process template with seven quality-control steps"
                  loading="lazy"
                />

                <img
                  class="process-drawer-reference"
                  src={assetPath("/images/benchmarkr-quality/process-drawer-full.png")}
                  alt="The full Step 4 configuration drawer with task definitions, pass and fail references, attachments, and completion settings"
                  loading="lazy"
                />
              </div>
            </div>

          </div>
          <figcaption>
            Selecting Step 4 opens its configuration drawer. The companion views show the full
            process template and the inspection tasks, reference imagery, attachments, and
            completion settings stored inside a reusable process step.
          </figcaption>
        </figure>

      </div>
    </section>

    <section class="quality-section quality-section--skus" aria-labelledby="skus-title">
      <div class="quality-section__heading quality-section__heading--wide">
        <h2 id="skus-title">Connect each SKU to a process template</h2>
      </div>

      <div class="process-intro quality-prose">
        <p>
          Once processes could stand on their own, each SKU only needed to reference the process
          used to manufacture it.
        </p>
        <p>
          This kept the quality definition consistent across variations in size, collection, and
          color without duplicating the same process on every SKU.
        </p>
      </div>

      <figure class="sku-figure">
        <img
          class="sku-catalog-image"
          src={assetPath("/images/benchmarkr-quality/sku-catalog.png")}
          alt="A Benchmarkr SKU catalog showing product collections, dimensions, colors, and statuses"
          loading="lazy"
        />
        <figcaption>
          Individual SKUs link to a reusable process instead of duplicating the same quality
          definition across every size, collection, and color variation.
        </figcaption>
      </figure>
    </section>

    <section class="quality-section quality-section--review" aria-labelledby="review-title">
      <div class="quality-section__heading quality-section__heading--wide">
        <p class="quality-eyebrow">Exception handling</p>
        <h2 id="review-title">Flagged products sent to Needs Review queue</h2>
      </div>

      <div class="process-intro quality-prose">
        <p>
          When an inspector detects a defect, Benchmarkr routes that serialized product out of the
          normal flow and into a shared Needs Review queue. Managers can see which products need
          attention, how many issues were found, and where each unit sits in its process.
        </p>
        <p>
          From there, they can clear the flag, send the product back to an earlier step for rework,
          or reject it outright and remove it from production.
        </p>
      </div>

      <figure class="review-figure">
        <img
          class="review-queue-image"
          src={assetPath("/images/benchmarkr-quality/needs-review-queue.png")}
          alt="The Benchmarkr Needs Review queue listing flagged products, their processes, issue counts, and review dates"
          loading="lazy"
        />
        <figcaption>
          The open queue turns a detected defect into an explicit management decision: clear it,
          route the product back for rework, or reject it and end its production run.
        </figcaption>
      </figure>
    </section>

    <section class="quality-section quality-section--pilot" aria-labelledby="pilot-title">
      <div class="quality-section__heading quality-section__heading--wide">
        <p class="quality-eyebrow">Pilot outcomes and learnings</p>
        <h2 id="pilot-title">What the pilot accomplished—and what it taught me</h2>
      </div>

      <p class="pilot-summary__intro">
        This was a focused pilot, not a factory-wide rollout. A working bilingual product was
        tested with factory leadership and floor users on one fire-table SKU. It showed how an
        approved standard, inspection evidence, and a management decision could stay connected to
        one serialized product. Measurable quality, time, and cost outcomes are still to be
        established.
      </p>

      <div class="pilot-summary__grid">
        <article class="pilot-summary__card">
          <h3>What it accomplished</h3>
          <ul>
            <li>
              Put approved pass and fail references beside photo capture at the inspector’s point
              of work.
            </li>
            <li>
              Connected reusable processes to individual SKUs and preserved the evidence history
              for each product.
            </li>
            <li>
              Gave managers a live Needs Review workflow with step-level context instead of an
              isolated paper record.
            </li>
          </ul>
        </article>

        <article class="pilot-summary__card">
          <h3>What I learned</h3>
          <ul>
            <li>
              Buyers and practitioners hold different kinds of truth; floor managers needed to be
              part of discovery earlier.
            </li>
            <li>
              Flexibility belongs at the Step and Task level, where the work varies—not in rigid
              process types.
            </li>
            <li>
              Factory conditions shape adoption: an iPad fit inspectors carrying clipboards, but
              not fabricators working in heavy gloves.
            </li>
          </ul>
        </article>
      </div>

      <div class="pilot-summary__next">
        <p>What comes next</p>
        <p>
          Broader use needs to show whether issues are caught before more labor or material is
          added, how quickly managers make review decisions, and which process Steps produce
          recurring issues.
        </p>
      </div>
    </section>
  </article>

  <nav class="quality-return quality-return--bottom" aria-label="Portfolio stories">
    <a class="quality-return__back" href={homeHref} aria-label="Back to stories">
      <span aria-hidden="true">←</span>
      <span class="quality-return__name">Jordan England-Nelson</span>
    </a>
    <NextCaseStudyCard
      title={nextStory.title}
      href={assetPath(nextStory.href)}
      thumbnail={assetPath(nextStoryThumbnail!)}
    />
  </nav>
  {showCopyReview && <CopyReviewToolbar />}
  <PhotoLightbox />
</BaseLayout>

<style>
  :global(.quality-case-main) {
    --quality-ink: #0b0c0f;
    --quality-muted: #4a5368;
    --quality-line: #d9d9d9;
    --quality-accent: #ffe89d;
    --quality-canvas: #fff8ef;
    overflow: hidden;
    background: var(--quality-canvas);
    color: var(--quality-ink);
  }

  .quality-case,
  .quality-return {
    width: min(1216px, calc(100% - 64px));
    margin-inline: auto;
  }

  .quality-return {
    display: flex;
    padding-top: 24px;
  }

  .quality-return--bottom {
    display: grid;
    align-items: center;
    gap: clamp(32px, 7vw, 96px);
    padding: 40px 0 64px;
    border-top: 1px solid var(--quality-line);
    grid-template-columns: auto minmax(320px, 440px);
    justify-content: space-between;
  }

  .quality-return__back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--quality-ink);
    font-family: var(--type-font-body);
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .quality-return__back > span[aria-hidden] {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .quality-return a:focus-visible {
    outline: 3px solid #7250d7;
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .quality-return__back:hover {
      color: #7250d7;
    }

    .quality-return__back:hover > span[aria-hidden] {
      transform: translateX(-3px);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .quality-return__back,
    .quality-return__back > span[aria-hidden] {
      transition: none;
    }
  }

  .quality-hero {
    display: grid;
    min-height: min(900px, calc(100vh - 68px));
    grid-template-columns: minmax(0, 1.55fr) minmax(340px, 0.9fr);
    align-items: stretch;
    gap: clamp(42px, 7vw, 104px);
    padding: clamp(52px, 7vw, 90px) 0 clamp(48px, 5vw, 72px);
  }

  .quality-hero__copy {
    display: grid;
    align-content: start;
  }

  .quality-eyebrow {
    margin: 0 0 24px;
    color: var(--quality-ink);
    font-family: var(--type-font-body);
    font-size: clamp(0.78rem, 1.25vw, 1.05rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .quality-hero h1,
  .quality-section h2 {
    margin: 0;
    font-family: var(--type-font-body);
    font-weight: 400;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .quality-hero h1 {
    max-width: 13.5ch;
    font-size: clamp(3.3rem, 6.1vw, 5rem);
    line-height: 1.18;
  }

  .quality-hero h1 span {
    position: relative;
    z-index: 0;
  }

  .quality-hero h1 span::after {
    position: absolute;
    z-index: -1;
    right: -0.08em;
    bottom: -0.02em;
    left: -0.12em;
    height: 0.17em;
    border-radius: 999px;
    background: var(--quality-accent);
    content: "";
    transform: rotate(-2deg);
  }

  .quality-hero__lede {
    max-width: 58ch;
    margin: clamp(44px, 6vw, 76px) 0 0;
    font-family: var(--type-font-body);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 400;
    line-height: 1.65;
  }

  .quality-facts {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.1fr);
    gap: 22px clamp(36px, 5vw, 72px);
    margin: auto 0 0;
    padding-top: clamp(52px, 7vw, 88px);
  }

  .quality-fact {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .quality-fact:nth-child(3),
  .quality-fact:nth-child(4) {
    grid-row: 2;
  }

  .quality-fact:nth-child(5),
  .quality-fact:nth-child(6) {
    grid-row: 3;
  }

  .quality-fact dt {
    color: var(--quality-muted);
    font-family: var(--type-font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .quality-fact dd {
    max-width: 34ch;
    margin: 0;
    font-family: var(--type-font-body);
    font-size: clamp(0.9rem, 1.25vw, 1.02rem);
    line-height: 1.55;
  }

  .quality-hero__visual {
    display: grid;
    align-items: center;
    justify-items: center;
  }

  .quality-hero-ipad {
    position: relative;
    width: min(160%, 650px);
    max-width: none;
    aspect-ratio: 1;
  }

  .quality-hero-ipad__screen {
    position: absolute;
    z-index: 1;
    top: 6.55%;
    left: 21.13%;
    overflow: hidden;
    width: 57.74%;
    height: 86.92%;
    border-radius: 3.4% / 2.2%;
    background: #fff;
  }

  .quality-hero__visual .quality-hero-ipad__screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
    object-position: top center;
  }

  .quality-hero__visual img.quality-hero-ipad__frame {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: fill;
    pointer-events: none;
  }

  .quality-section {
    padding: clamp(92px, 12vw, 154px) 0;
    border-top: 1px solid var(--quality-line);
  }

  .quality-section__heading {
    max-width: 1100px;
    margin-bottom: clamp(70px, 9vw, 104px);
  }

  .quality-section__heading--wide {
    max-width: 1160px;
  }

  .quality-section h2 {
    font-size: clamp(2.6rem, 4.5vw, 3.75rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .human-problem-grid,
  .technology-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(390px, 0.9fr);
    align-items: start;
    gap: clamp(60px, 8vw, 112px);
  }

  .quality-prose {
    display: grid;
    gap: clamp(42px, 6vw, 72px);
    font-family: var(--type-font-body);
  }

  .quality-prose > p {
    max-width: 57ch;
    margin: 0;
    font-size: clamp(1rem, 1.65vw, 1.2rem);
    line-height: 1.65;
  }

  .quality-prose blockquote {
    display: grid;
    gap: 30px;
    margin: clamp(16px, 2vw, 24px) 0;
  }

  .quality-prose blockquote p {
    max-width: 17ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.4rem, 4.4vw, 4rem);
    font-style: italic;
    line-height: 1.22;
  }

  .quality-prose blockquote footer {
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 1.5;
  }

  .human-problem-visual {
    position: relative;
    margin: 0;
  }

  .human-problem-visual img,
  .technology-visual {
    display: block;
    width: 100%;
    height: auto;
  }

  .human-problem-callout {
    position: absolute;
    top: 20.5%;
    right: 3%;
    bottom: 51.5%;
    left: 34%;
    box-sizing: border-box;
    padding: clamp(18px, 2.25vw, 26px);
    border: 1px solid var(--quality-line);
    border-radius: 8px;
    background: var(--quality-canvas);
    box-shadow: 0 12px 32px rgb(11 12 15 / 12%);
    color: var(--quality-ink);
    font-family: var(--type-font-body);
    font-size: clamp(0.9rem, 1.45vw, 1.05rem);
    letter-spacing: -0.02em;
